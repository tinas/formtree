{
  "compilerOptions": {
    "target": "es2023",
    "module": "esnext",
    "lib": ["es2023", "dom", "dom.iterable"],
    "types": ["node"],
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "@formtree/core": ["../../packages/core/src/index.ts"],
      "@formtree/vue": ["../../packages/vue/src/index.ts"]
    }
  },
  "include": [".vitepress/**/*.ts", ".vitepress/**/*.vue", "examples/**/*.ts", "examples/**/*.vue"]
}
